includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # SECURITY: Maximum analysis level for production code
    # Level 8 = Very strict type checking, catches most potential bugs
    level: 8
    
    paths:
        - app
        - config
        - routes
        - app/Policies
        - app/Http/Requests
        - app/Http/Controllers
        - app/Models
        - app/Providers
        - app/Mcp
        - app/Services/AI
        - app/Modules/Inventory/Controllers
    
    excludePaths:
        - app/Console/Commands/GrantSuperAdmin.php
        - storage
        - vendor
        - bootstrap/cache
        - node_modules
    
    tmpDir: storage/phpstan
    
    # Enable strict mixed types - catches implicit mixed types
    
    # Check for unused properties and parameters
    
    # Detect dead code
    
    # Generic class usage detection
    
    # Universal object crash fixer
    
    # SECURITY: Ignore only known Laravel magic property/method patterns
    # Intentionally minimal to catch potential security issues
    ignoreErrors:
        # Eloquent dynamic properties (necessary for ORM)
        - '#Access to an undefined property.*Model::\$#'
        # Laravel helpers that use dynamic methods
        - '#Call to an undefined method.*Builder::(.*where|orderBy|select|groupBy|join|with|has|whereHas)#'
        # Sanctum token method
        - '#Call to an undefined method.*User::currentAccessToken#'
        # Relation loading methods
        - '#Call to an undefined method.*Model::load#'
        # Collection methods
        - '#Call to an undefined method.*Collection::(pluck|keyBy|groupBy)#'
    
    # Do not report ignored errors that are not encountered
    reportUnmatchedIgnoredErrors: false
